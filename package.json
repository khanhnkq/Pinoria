{
  "name": "pinoria",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first Pinterest media downloader for Chromium browsers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build -c vite.pages.config.ts",
    "video:studio": "remotion studio src/remotion/index.ts --no-open",
    "video:render": "remotion render src/remotion/index.ts PinoriaDemo out/pinoria-demo.mp4",
    "video:still": "remotion still src/remotion/index.ts PinoriaDemo out/pinoria-demo-cover.png --frame=90",
    "video:cinematic": "remotion render src/remotion/index.ts PinoriaCinematic out/pinoria-demo-cinematic.mp4",
    "video:cinematic:still": "remotion still src/remotion/index.ts PinoriaCinematic out/pinoria-demo-cinematic-cover.png --frame=45",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@remotion/media": "4.0.503",
    "@zip.js/zip.js": "^2.8.34",
    "mediabunny": "^1.52.2",
    "pdf-lib": "^1.17.1",
    "uisfx": "^0.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.503",
    "@remotion/transitions": "^4.0.503",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.503",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
